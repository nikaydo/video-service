# Шаблон конфигурации. Скопируйте его в .env и подставьте реальные значения:
#
#   cp .env.example .env
#
# Приложение проверяет конфигурацию при старте и не запустится, пока
# значения остались заглушками CHANGE_ME.

# ─────────────────────────────────────────────────────────────────────────────
# MongoDB
# ─────────────────────────────────────────────────────────────────────────────
# Допустимы схемы mongodb:// и mongodb+srv://
MONGODB_URI=CHANGE_ME
MONGODB_NAME=video

# ─────────────────────────────────────────────────────────────────────────────
# Хранение файлов
# ─────────────────────────────────────────────────────────────────────────────
# Каталог создаётся при старте, если не существует.
#
# Название файла строится только из сгенерированного UUID, поэтому значение
# из запроса в путь не подставляется никогда. Тем не менее каталог стоит
# вынести на отдельный том, чтобы видео не занимало место контейнера.
VIDEO_DIR=./storage/video

# ─────────────────────────────────────────────────────────────────────────────
# gRPC
# ─────────────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=50053

# ─────────────────────────────────────────────────────────────────────────────
# Пределы
# ─────────────────────────────────────────────────────────────────────────────
# Предел входящего сообщения в байтах. Видео передаётся целиком в Add,
# поэтому значение должно быть больше MAX_VIDEO_BYTES с запасом на заголовок.
MAX_MESSAGE_BYTES=26214400

# Предел размера одного видеофайла в байтах.
MAX_VIDEO_BYTES=20971520

# Размер порции при потоковой передаче. Если значение больше предела
# сообщения, оно автоматически уменьшается.
STREAM_CHUNK_BYTES=65536

# Сколько меток можно задать при загрузке.
TAG_LIMIT=20

# Сколько ждать завершения текущих запросов при остановке.
SHUTDOWN_TIMEOUT=30s
